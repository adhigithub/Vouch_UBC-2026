# Copy to .env and fill in. Never commit .env.

# The Stream's "Security token" from the QuickNode dashboard (Stream → Settings).
# The Vouch server needs the SAME value to verify deliveries.
QN_STREAM_SECRET=

# Local test receiver port
RECEIVER_PORT=4000

# Used by test-filter.js to fetch real transactions
SOLANA_RPC_URL=https://api.devnet.solana.com
