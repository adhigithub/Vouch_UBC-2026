# Copy to .env and fill in. Never commit .env.

PORT=4000
# Where the fake APIs run (the server loads endpoints from its /catalog)
FAKE_APIS_URL=http://localhost:3001
# SQLite file for endpoints, verified payments, ratings and reviews
DB_FILE=vouch.db

# The QuickNode Stream's "Security token" (dashboard -> Stream -> Settings).
# Same value as QN_STREAM_SECRET in stream/.env. The server checks every
# delivery's X-QN-Signature with it, so nobody can fake "verified" payments.
QN_STREAM_SECRET=

# Shared secret for the stand-in (scripts/simulate-stream.js), sent in the
# x-vouch-webhook-secret header. Only needed if you run the stand-in.
WEBHOOK_SECRET=

# Protects /admin routes (e.g. setting test scores). Required to use them.
ADMIN_TOKEN=

# Test score (T) for endpoints the tester bot hasn't scored yet (0-100).
# The tester bot will replace this; until then it's our fixed starting T.
DEFAULT_TEST_SCORE=80

SOLANA_RPC_URL=https://api.devnet.solana.com

# The Vouch program on devnet (program/ in this repo)
VOUCH_PROGRAM_ID=GyYPjRNghiX96xFtP98eNMiYjKfrF5ktKLf1Mm2YBgni
# The server's own Solana key: the only key the program accepts ratings from.
# Created by `npm run chain:setup`. Pays a tiny fee + storage per rating, so keep ~0.5 SOL on it.
SOLANA_SERVER_SECRET_KEY=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
