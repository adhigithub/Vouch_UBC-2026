# Copy to .env and fill in. Never commit .env.

PORT=4000
# Where the fake APIs run (the server loads endpoints from its /catalog)
FAKE_APIS_URL=http://localhost:3001
# SQLite file for endpoints, verified payments, ratings and reviews
DB_FILE=vouch.db

# Shared secret QuickNode (or scripts/simulate-stream.js) sends in the
# x-vouch-webhook-secret header. Without it, anyone could fake "verified" payments.
WEBHOOK_SECRET=

# Protects /admin routes (e.g. setting test scores). Required to use them.
ADMIN_TOKEN=

# Test score (T) for endpoints the tester bot hasn't scored yet (0-100).
# The tester bot will replace this; until then it's our fixed starting T.
DEFAULT_TEST_SCORE=80

SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
