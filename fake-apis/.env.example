# Copy to .env and fill in. Never commit .env.

PORT=3001
# Public base URL used in /catalog (set this if exposed via ngrok etc.)
PUBLIC_URL=
# on = x402 paywall (needs wallets.json from `npm run setup`), off = free mode
PAYMENTS=on
FACILITATOR_URL=https://x402.org/facilitator
SOLANA_RPC_URL=https://api.devnet.solana.com
# If set, /admin routes require header x-admin-token
ADMIN_TOKEN=
# How long the "slow" mode waits (ms)
SLOW_MS=5000

# Optional: pay for USDC account creation with this wallet instead of a generated one
SETUP_PAYER_SECRET_KEY=
# Optional: buyer for `npm run buy` (defaults to testBuyer in wallets.secret.json)
BUYER_SECRET_KEY=
